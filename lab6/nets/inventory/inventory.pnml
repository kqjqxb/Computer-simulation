      <transition id="t-2964cca3">
        <name>
          <text>Надходження покупця</text>
        </name>
        <toolspecific tool="PetriObjModel" version="2.3.0">
          <timeDelay>0.2</timeDelay>
          <delayMeanValue>0.2</delayMeanValue>
          <distribution>exp</distribution>
